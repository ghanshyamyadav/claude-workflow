# Default provider: drives Claude Code as the executor subprocess, backed by a
# local model via an Anthropic-compatible shim (e.g. LiteLLM fronting Ollama).
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_API_KEY=sk-workflow-local
ANTHROPIC_MODEL=

# Raw-diff providers (only used when executor.provider is ollama / llamacpp /
# openai-compatible). Override per-provider endpoints from .workflow/config.json.
OLLAMA_ENDPOINT=http://localhost:11434
LLAMACPP_ENDPOINT=http://localhost:8080
OPENAI_COMPATIBLE_ENDPOINT=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=

# Optional override of the raw-provider model name.
WORKFLOW_EXECUTOR_MODEL=

# Ollama context window. Ollama silently clamps num_ctx in some versions
# (see ollama/ollama#10974); this env var is the reliable per-process override.
# Claude Code's system prompt alone is ~16K tokens — 65536 is the safe minimum.
OLLAMA_CONTEXT_LENGTH=65536
